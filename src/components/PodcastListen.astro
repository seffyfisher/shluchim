---
import SpotifyPlayer from './SpotifyPlayer.astro';
import { lurl, type Lang } from '../i18n/ui';
import { PODCAST_UI } from '../i18n/podcast';
import type { Episode } from '../data/podcast';
interface Props { episode: Episode; lang?: Lang }
const { episode, lang = 'he' } = Astro.props;
const ui = PODCAST_UI[lang];
---
<aside class="podcast-listen" aria-labelledby="podcast-listen-heading">
  <div class="podcast-listen-head">
    <h2 id="podcast-listen-heading">{ui.heading}</h2>
    <p class="meta">{episode.number && <span>{ui.episode} {episode.number}</span>}<span><bdi>{episode.duration}</bdi> {ui.minutes}</span></p>
  </div>
  <p class="podcast-note">{ui.note}</p>
  <SpotifyPlayer kind="episode" spotifyId={episode.spotifyId} title={`${ui.player.titlePrefix}${episode.title}`} lang={lang} />
  <p class="podcast-links"><a href={episode.spotifyUrl} target="_blank" rel="noopener">{ui.spotifyLink}<span class="sr-only">{ui.newTab}</span></a><a href={lurl('he', 'podcast/')}>{ui.podcastPage}</a></p>
</aside>
