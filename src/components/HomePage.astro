---
import Base from '../layouts/Base.astro';
import StoryList from './StoryList.astro';
import shluchim from '../data/shluchim.json';
import { getHomePosts } from '../lib/posts';
import { lurl, t, type Lang } from '../i18n/ui';
import { SEO_HOME } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const posts = await getHomePosts(lang);
const hasFeatured = posts.some((post) => post.data.featured);
const he = lang === 'he';
const seo = SEO_HOME[lang];
// Cards above the story list: the featured shaliach and the About card. The shaliach is fixed (not random: random needs JS).
const FEATURED_SHALIACH = 'basher';
const s = shluchim.find((x) => x.id === FEATURED_SHALIACH)!;
const shaliach = he ? { name: s.name, role: s.role, example: s.example } : { name: s.name_en, role: s.role_en, example: s.example_en };
// The about card is four short lines in small type (Seffy's own Hebrew wording, 2026-10-11; the English is a translation, one paragraph per line).
// A line is a list of parts: plain text, or a link (L). Links: visual artist -> shinlamed.com, "Evrit" (the company) -> e-vrit.co.il, father of two -> the Hebrew Wikipedia article on parenthood.
type Part = string | { t: string; href: string };
const L = (t: string, href: string) => ({ t, href });
const ART = 'https://shinlamed.com';
const EVRIT = 'https://e-vrit.co.il';
const PARENTHOOD = 'https://he.wikipedia.org/wiki/%D7%94%D7%95%D7%A8%D7%95%D7%AA';
const aboutCard: { kick: string; title: string; text: Part[][]; btn: string } = he
  ? { kick: 'האדם מאחורי הבלוג', title: 'מי אני', text: [['קוראים לי ספי פישר.'], ['אני ', L('אמן חזותי', ART), ', CTO של ׳', L('עברית', EVRIT), '׳, ', L('אבא לשניים', PARENTHOOD), ', ומופרע קשב עם בעיות ויסות רגשי.'], ['וכמו כולם, מנסה ללמוד להתמודד עם השינויים שה־AI מביא.'], ['הבלוג הזה הוא הדרך שלי לעשות את זה בקול רם.']], btn: 'עוד עליי' }
  : { kick: 'The person behind the blog', title: 'Who I am', text: [['My name is Seffy Fisher.'], ["I'm a ", L('visual artist', ART), ', a CTO of \u2018', L('Hebrew', EVRIT), '\u2019, a ', L('father of two', PARENTHOOD), ', and a person with ADHD and emotional regulation problems.'], ["Like everyone, I'm trying to learn to cope with the changes AI brings."], ['This blog is my way of doing that out loud.']], btn: 'More about me' };
---
<Base masthead noindex={!he && posts.length === 0} lang={lang} alternates={{ he: lurl('he'), en: lurl('en') }} seoTitle={seo.title} seoDescription={seo.description}>
  <section class="intro" aria-label={he ? 'פתיח' : 'Intro'}>
    {he ? (
      <>
        <p>פה אני והשְׁלוּחִים, עוזרי הAI שלי, מתעדים עבודה משותפת</p>
        <p>כל מעשיה מראה מה ביקשתי, מה נעשה, אילו שְׁלוּחִים השתתפו ומה יצא.</p>
        <p>בלי פלאף, כמו חבר שאומר לך: בוא שב לידי ותראה מה אני עושה.</p>
      </>
    ) : (
      <>
        <p>This is where my shluchim and I document every win we have.<br />(Shluchim, singular shaliach, is Hebrew for "emissaries". It's what I call my AI agents.)</p>
        <p>Each story shows what I asked for, what got done, which shluchim took part, and how it turned out.</p>
        <p>No fluff. Just a friend saying: come sit next to me and see what I'm doing.</p>
      </>
    )}
  </section>
  <div class="cards">
    <article class="card">
      <p class="kick">{he ? 'מִיהוּ שָׁלוּחַ?' : 'Who is a shaliach?'}</p>
      {/* The picture links to the team page too. The "Meet the shluchim" button below is the named link, so this one stays out of the tab order and the screen reader list. */}
      <a href={lurl(lang, 'team/')} tabindex="-1" aria-hidden="true">
        <picture>
          {s.still && <source media="(prefers-reduced-motion: reduce)" srcset={lurl('he', s.still)} type="image/webp" />}
          <img class="avatar" src={lurl('he', s.avatar)} alt="" width="112" height="112" loading="lazy" decoding="async" />
        </picture>
      </a>
      <h2>{he ? `למשל ${shaliach.name}` : shaliach.name}</h2>
      <p>{shaliach.role}</p>
      <p class="example">{shaliach.example}</p>
      <a class="btn" href={lurl(lang, 'team/')}>{he ? 'הכירו את השְׁלוּחִים' : 'Meet the shluchim'}</a>
    </article>
    <article class="card">
      <p class="kick">{aboutCard.kick}</p>
      <h2>{aboutCard.title}</h2>
      {aboutCard.text.map((line) => <p class="about-line">{line.map((part) => typeof part === 'string' ? part : <a href={part.href} target="_blank" rel="noopener">{part.t}</a>)}</p>)}
      <a class="btn" href={lurl(lang, 'about/')}>{aboutCard.btn}</a>
    </article>
  </div>
  {posts.length === 0 ? (
    he
      ? <p class="empty">עוד אין פה מעשיות.<br />השְׁלוּחִים כבר עובדים על הראשונה.</p>
      : <p class="empty">The English translations are on their way.<br />Meanwhile, the stories are all <a href={lurl('he')} hreflang="he" lang="he">in Hebrew</a>.</p>
  ) : (
    <>
      <h2 class="list-label" id="stories">{he
        ? `${posts.length === 1 ? 'מעשיה אחת' : `${posts.length} מעשיות`}${hasFeatured ? '' : ', מהחדשה לישנה'}`
        : `${posts.length === 1 ? 'One story' : `${posts.length} stories`}${hasFeatured ? '' : ', newest first'}`}</h2>
      <StoryList posts={posts} lang={lang} />
    </>
  )}
</Base>
