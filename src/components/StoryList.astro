---
// The story list, shared by the homepage and the topic hubs. Each story shows its emoji (HE frontmatter, shared by translationKey).
import { getCollection, type CollectionEntry } from 'astro:content';
import { postUrl, formatDateShort, topicsOf, keyOf } from '../lib/posts';
import { t, type Lang } from '../i18n/ui';
import { storyImage, previewUrl, previewSrcset } from '../lib/story-images.mjs';
interface Props { posts: CollectionEntry<'posts'>[]; lang: Lang; illustrated?: boolean }
const { posts, lang, illustrated = false } = Astro.props;
const ui = t(lang);
const emojiByKey = new Map((await getCollection('posts', (p) => p.id.startsWith('he/'))).map((p) => [keyOf(p), p.data.emoji]));
const images = illustrated ? await Promise.all(posts.map(storyImage)) : [];
---
<ol class:list={['stories', { 'stories-illustrated': illustrated }]} reversed>
  {posts.map((p, i) => {
    const topics = topicsOf(p, lang);
    return (
      <li class:list={['story', { 'has-image': !!images[i] }]}>
        {images[i] && <span class="story-art-frame" data-story-art-frame>
          <img class="story-art" src={previewUrl(images[i], 160)} srcset={previewSrcset(images[i], [160, 320])} sizes="9rem" width={images[i].width} height={images[i].height} alt="" aria-hidden="true" loading="lazy" decoding="async" />
        </span>}
        <span class="num emoji" aria-hidden="true">{p.data.emoji || emojiByKey.get(keyOf(p)) || '•'}</span>
        <p class="meta">
          <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDateShort(p.data.date, lang)}</time>
          {topics.length ? <span>{topics.map((tp, k) => <>{k > 0 && ', '}<a href={tp.href}>{tp.chip}</a></>)}</span> : null}
          {p.data.tags?.length ? <span>{p.data.tags.join(', ')}</span> : null}
          {p.data.draft && <span class="badge">{ui.draft}</span>}
        </p>
        <h3><a href={postUrl(p)}>{p.data.title}</a></h3>
        <p class="dek">{p.data.listDescription ?? p.data.description}</p>
      </li>
    );
  })}
</ol>
