---
import type { Lang } from '../i18n/ui';
import sun from '../assets/theme/sun.webp';
import moon from '../assets/theme/moon.webp';
import computer from '../assets/theme/computer.webp';
interface Props { lang: Lang }
const { lang } = Astro.props;
const options = [
  { value: 'dark', image: moon, label: lang === 'he' ? 'מצב לילה' : 'Dark mode' },
  { value: 'light', image: sun, label: lang === 'he' ? 'מצב יום' : 'Light mode' },
  { value: 'system', image: computer, label: lang === 'he' ? 'לפי המערכת' : 'System theme' },
];
---
<fieldset class="theme-toggle">
  <legend class="sr-only">{lang === 'he' ? 'ערכת נושא' : 'Theme'}</legend>
  <span class="theme-thumb" aria-hidden="true"></span>
  {options.map(({ value, image, label }) => (
    <label class="theme-option" title={label}>
      <input class="sr-only" type="radio" name="shluchim-theme-mode" value={value} checked={value === 'system'} />
      <img src={image.src} alt="" aria-hidden="true" width="24" height="24" />
      <span class="sr-only">{label}</span>
    </label>
  ))}
</fieldset>
<script>
  const key = 'shluchim-theme';
  const preference = matchMedia('(prefers-color-scheme: dark)');
  const choices = document.querySelectorAll<HTMLInputElement>('.theme-option input');
  type Theme = 'light' | 'dark' | null;
  const parse = (value: string | null): Theme => value === 'light' || value === 'dark' ? value : null;
  const sync = () => choices.forEach((choice) => { choice.checked = choice.value === (document.documentElement.dataset.theme || 'system'); });
  const apply = (theme: Theme, persist = true) => {
    if (theme) document.documentElement.dataset.theme = theme;
    else delete document.documentElement.dataset.theme;
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((meta) => {
      const dark = theme ? theme === 'dark' : (meta.getAttribute('media')?.includes('dark') ?? preference.matches);
      meta.content = dark ? '#141414' : '#fafafa';
    });
    if (persist) try {
      if (theme) localStorage.setItem(key, theme);
      else localStorage.removeItem(key);
    } catch { /* storage may be disabled; the current page still updates */ }
    sync();
  };
  sync();
  preference.addEventListener('change', sync);
  for (const choice of choices) choice.addEventListener('change', () => {
    if (choice.checked) apply(parse(choice.value));
  });
  // A choice made in another open blog tab should remain the same preference here.
  window.addEventListener('storage', (event) => {
    if (event.key === key || event.key === null) apply(parse(event.newValue), false);
  });
</script>
