---
interface Props {
  variant: 'male' | 'female';
  color: string;
}
const { variant, color } = Astro.props;
---
<svg class="human-silhouette" viewBox="0 0 96 96" aria-hidden="true" focusable="false" style={`--portrait-color: ${color}`}>
  <circle class="portrait-paper" cx="48" cy="48" r="46" />
  {variant === 'female' ? (
    <path class="portrait" d="M48 15c-15 0-22 12-22 27 0 10-2 18-6 23 7 3 13 3 18 1v2c-2 5-16 5-21 14a43 43 0 0 0 62 0c-5-9-19-9-21-14v-2c5 2 11 2 18-1-4-5-6-13-6-23 0-15-7-27-22-27Zm-13 26c6-1 11-5 14-11 3 7 7 10 12 11v7c0 10-6 17-13 17s-13-7-13-17v-7Z" />
  ) : (
    <path class="portrait" d="M48 15c-12 0-20 8-20 20v8c-3 0-4 3-3 7 1 3 2 5 5 5 2 7 5 12 10 15v5c-2 4-17 4-23 12a44 44 0 0 0 62 0c-6-8-21-8-23-12v-5c5-3 8-8 10-15 3 0 4-2 5-5 1-4 0-7-3-7v-8c0-12-8-20-20-20Z" />
  )}
  <circle class="portrait-ring" cx="48" cy="48" r="46" />
</svg>
<style>
  .human-silhouette { display: block; width: 5rem; height: 5rem; flex: 0 0 5rem; }
  .portrait-paper { fill: var(--surface); }
  .portrait { fill: var(--portrait-color); }
  .portrait-ring { fill: none; stroke: var(--line); stroke-width: 1; }
</style>
