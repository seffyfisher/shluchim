---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FeedbackBlock from './FeedbackBlock.astro';
import IdeaBlock from './IdeaBlock.astro';
import PodcastListen from './PodcastListen.astro';
import { episodeForPost } from '../data/podcast';
import { ideaPrompt } from '../lib/idea-prompt';
import { imageLabels, imagePopover } from '../lib/image-viewer.mjs';
import '../styles/image-viewer.css';
import { langOf, keyOf, postUrl, getPosts, getTranslation, formatDate, formatDateShort, readingMinutes, readingLabel, topicsOf, relatedPosts } from '../lib/posts';
import { lurl, t } from '../i18n/ui';
import { REPO, SITES, SEO_KEYWORDS, OG_IMAGE } from '../config';
import { blogPostingNode, breadcrumbNode, nodeIds, withBrand, isoDate, wordCount } from '../lib/seo';
import { postOgImage, ogUrl } from '../lib/og-images.mjs';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const podcastEpisode = episodeForPost(post.id);
const lang = langOf(post);
const ui = t(lang);
const { Content } = await render(post);
const d = post.data;
const tr = await getTranslation(post);
const alternates = tr ? { [langOf(tr)]: postUrl(tr) } : {};
const editUrl = `https://github.com/${REPO}/edit/main/${post.filePath ?? `src/content/posts/${post.id}.md`}`;

const topics = topicsOf(post, lang);
const related = relatedPosts(await getPosts(lang), post);

// SEO: <title> / meta description come from seoTitle / seoDescription when set; the page itself keeps title + description.
const abs = (p: string) => new URL(p, Astro.site).href;
const pageUrl = abs(postUrl(post));
const prompt = ideaPrompt(lang, {
  title: d.title, description: d.description, body: post.body ?? '', published: isoDate(d.date),
  updated: d.updated ? isoDate(d.updated) : undefined,
  pageUrl, blogUrl: abs(lurl(lang)), aboutUrl: abs(lurl(lang, 'about/')), feedUrl: abs(lurl(lang, 'rss.xml')),
  translationUrl: tr ? abs(postUrl(tr)) : undefined,
  coverUrl: d.cover ? abs(d.cover.src) : undefined, coverAlt: d.coverAlt,
});
const seoTitle = d.seoTitle ? withBrand(d.seoTitle, SITES[lang].title) : undefined;
const seoDescription = d.seoDescription ?? d.description;
const modified = d.updated ?? d.date;
// Share card: a 1200x630 crop of the post's own artwork, prerendered by src/pages/og/posts/[image].jpg.ts.
const og = await postOgImage(post);
const socialImage = og ? ogUrl(keyOf(post), og) : undefined;
const socialImageAlt = og ? (og.alt || d.title) : undefined;
const ids = nodeIds(abs(lurl('he')), abs(lurl(lang)));
const keywords = [...new Set([...topics.map((x) => x.label), ...(d.tags ?? []), ...SEO_KEYWORDS[lang]])];
const jsonLd = [
  blogPostingNode({
    url: pageUrl, headline: d.title, description: seoDescription, lang, published: isoDate(d.date), modified: isoDate(modified),
    image: socialImage ? abs(socialImage) : abs(lurl('he', OG_IMAGE.file[lang])), blogId: ids.blog, personId: ids.person, keywords, section: topics[0]?.label, words: wordCount(post.body),
  }),
  breadcrumbNode([
    { name: SITES[lang].title, url: abs(lurl(lang)) },
    ...(topics[0] ? [{ name: topics[0].label, url: abs(topics[0].href) }] : []),
    { name: d.title, url: pageUrl },
  ]),
];
---
<Base title={d.title} description={d.description} seoTitle={seoTitle} seoDescription={seoDescription} noindex={d.draft} lang={lang} alternates={alternates}
  ogType="article" published={d.date} modified={modified} section={topics[0]?.label} tags={topics.map((x) => x.label)}
  image={socialImage} imageAlt={socialImageAlt} imageWidth={og?.width} imageHeight={og?.height} jsonLd={jsonLd}>
  <article>
    <header class="post-head">
      <p class="meta">
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang)}</time>
        <span>{readingLabel(readingMinutes(post.body, lang), lang)}</span>
        {topics.length ? <span>{topics.map((tp, k) => <>{k > 0 && ', '}<a href={tp.href}>{tp.chip}</a></>)}</span> : null}
        {d.tags?.length ? <span>{d.tags.join(', ')}</span> : null}
        {d.draft && <span class="badge">{ui.draft}</span>}
      </p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
    </header>
    {podcastEpisode && <PodcastListen episode={podcastEpisode} />}
    {d.cover && <>
      <button class="image-enlarge image-enlarge-cover" type="button" popovertarget="post-cover" aria-label={imageLabels(lang).open}>
        <Image class="cover" src={d.cover} alt={d.coverAlt ?? ''} widths={[400, 800, 1200]} sizes="(max-width: 46rem) 100vw, 46rem" />
      </button>
      <Fragment set:html={imagePopover({ id: 'post-cover', src: d.cover.src, alt: d.coverAlt ?? '', lang })} />
    </>}
    <div class="prose">
      <Content />
      {lang === 'he' && !d.hideWaCta && (
        <p class="post-invite"><strong>בונים שְׁלוּחִים? בואו לשאול.</strong><br /><svg class="wa-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>בונים שְׁלוּחִים ב־Grok Bot או בכלים דומים, <a href="https://chat.whatsapp.com/H1FJhw9lUCV8heZMsMjkM7" target="_blank" rel="noopener">יש קבוצת ווטסאפ</a> קטנה שבה אפשר ללמוד וללמד</p>
      )}
    </div>
  </article>
  <IdeaBlock lang={lang} prompt={prompt} />
  {lang === 'he' && <FeedbackBlock placement="post" />}
  {related.length > 0 && (
    <aside class="related" aria-labelledby="related-h">
      <h2 class="list-label" id="related-h">{ui.related}</h2>
      <ul>
        {related.map((r) => (
          <li>
            <h3><a href={postUrl(r)}>{r.data.title}</a></h3>
            <p class="meta"><time datetime={r.data.date.toISOString().slice(0, 10)}>{formatDateShort(r.data.date, lang)}</time></p>
          </li>
        ))}
      </ul>
    </aside>
  )}
  <nav class="post-foot" aria-label={ui.postNav}>
    <a class="back" href={lurl(lang)}>{ui.back}</a>
    <a class="edit" href={editUrl} rel="nofollow noopener" target="_blank">{ui.edit}</a>
  </nav>
</Base>
<script>
  // Gesture code is fetched only when someone actually opens a post image.
  const loadImageGestures = () => {
    document.removeEventListener('beforetoggle', onImageOpen, true);
    import('../lib/image-gestures');
  };
  const onImageOpen = (event: Event) => {
    if ((event as ToggleEvent).newState !== 'open' || !(event.target instanceof HTMLElement) || !event.target.matches('.image-viewer')) return;
    loadImageGestures();
  };
  document.addEventListener('beforetoggle', onImageOpen, true);
  // Production loads this entry after the native popover has already opened.
  if (document.querySelector('.image-viewer:popover-open')) loadImageGestures();
</script>
