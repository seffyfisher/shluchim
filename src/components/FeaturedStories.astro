---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { postUrl, formatDateShort, readingMinutes, readingLabel, keyOf } from '../lib/posts';
import { storyImage, previewUrl, previewSrcset } from '../lib/story-images.mjs';
interface Props { posts: CollectionEntry<'posts'>[]; lang: Lang }
const { posts, lang } = Astro.props;
const COPY: Record<Lang, { start: string; guideCta: string; storyCta: string; qMark: string }> = {
  he: { start: 'כדאי להתחיל כאן', guideCta: 'למדריך המלא', storyCta: 'למעשיה המלאה', qMark: '?' },
  en: { start: 'A good place to start', guideCta: 'Read the full guide', storyCta: 'Read the full story', qMark: '?' },
  ar: { start: 'نقطة بداية ممتازة', guideCta: 'اقرأ الدليل الكامل', storyCta: 'اقرأ الحكاية كاملة', qMark: '؟' },
};
const copy = COPY[lang];
const entries = await Promise.all(posts.map(async (post) => {
  const guide = keyOf(post) === 'grok-bot-guide';
  const description = post.data.listDescription ?? post.data.description;
  const qIdx = Math.max(-1, ...[copy.qMark, '?'].map((q) => description.indexOf(q)).filter((i) => i >= 0));
  // The guide's own opening question is its short editorial teaser; the article and metadata stay intact.
  const teaser = guide && !post.data.listDescription && qIdx >= 0 ? description.slice(0, qIdx + 1) : description;
  return { post, guide, teaser, image: await storyImage(post) };
}));
---
<section class="featured-section" aria-labelledby="featured-title">
  <header class="featured-heading">
    <h2 id="featured-title">{lang === 'he' ? <>מעשיות <mark>נבחרות</mark></> : lang === 'en' ? <>Featured <mark>stories</mark></> : <>حكايات <mark>مختارة</mark></>}</h2>
    <p>{copy.start}</p>
  </header>
  <ol class="featured-stories" role="list">
    {entries.map(({ post, guide, teaser, image }) => (
      <li class:list={['featured-story', { 'has-image': !!image }]}>
        {image && <span class="featured-art-frame" data-story-art-frame>
          <img class="featured-art" src={previewUrl(image, 768)} srcset={previewSrcset(image, [480, 768, 1120, 1536])} sizes="(min-width: 62.5rem) 35rem, (min-width: 48rem) calc(58.334vw - 1.46rem), calc(100vw - 2.5rem)" width={image.width} height={image.height} alt={image.alt} loading="lazy" decoding="async" fetchpriority="low" />
        </span>}
        <div class="featured-copy">
          <p class="meta"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDateShort(post.data.date, lang)}</time><span>{readingLabel(readingMinutes(post.body, lang), lang)}</span></p>
          <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
          <p class="dek">{teaser}</p>
          <span class="featured-cta" aria-hidden="true">{guide ? copy.guideCta : copy.storyCta}</span>
        </div>
      </li>
    ))}
  </ol>
</section>
