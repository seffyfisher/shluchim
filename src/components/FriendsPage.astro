---
import Base from '../layouts/Base.astro';
import { friends, type Friend } from '../data/friends';
import { friendPortraits } from '../data/friend-portraits';
import { lurl, type Lang } from '../i18n/ui';
import { SITES } from '../config';
import { getPosts, keyOf, postUrl } from '../lib/posts';
import { pageNode, breadcrumbNode, nodeIds, withBrand } from '../lib/seo';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fName = (f: Friend) => ({ he: f.name, en: f.nameEn, ar: f.nameAr })[lang];
const fTheme = (f: Friend) => ({ he: f.theme, en: f.themeEn, ar: f.themeAr })[lang];
const fText = (f: Friend) => ({ he: f.text, en: f.textEn, ar: f.textAr })[lang];
const COPY: Record<Lang, {
  title: string; description: string; seoTitle: string; seoDescription: string;
  subtitle: string; intro: string; jumpLabel: string; onPage: string; count: string;
  listLabel: string; photoSource: (name: string, src: string) => string;
  linksLabel: (name: string) => string; photoCredit: (photographer: string) => string;
  moreHeading: string; moreIntro: string; stories: [string, string, string];
  nav: string; back: string;
}> = {
  he: {
    title: 'בני אנוש',
    description: 'אנשים שאני עוקב אחריהם ומקבל מהם השראה, עם קשר ובלי קשר ל־AI. כמה מילים וקישורים, כדי שגם אתם תוכלו להכיר.',
    seoTitle: 'בני אנוש: אנשים שנותנים לי השראה',
    seoDescription: `${friends.length} אנשים שאני עוקב אחריהם ומקבל מהם השראה, עם קשר ובלי קשר ל־AI. כמה מילים על העשייה שלהם וקישורים לתוכן שהם משתפים.`,
    subtitle: 'אנשים שאני עוקב אחריהם ומקבל מהם השראה',
    intro: 'יש כאן אנשים שאני עוקב אחריהם ולומד מהעשייה שלהם, עם קשר ובלי קשר ל־AI. כמה מילים על כל אחד וקישורים, כדי שגם אתם תוכלו להכיר.',
    jumpLabel: 'קפיצה לאדם בדף', onPage: 'על הדף', count: `${friends.length} בני אנוש`,
    listLabel: 'אנשים שנותנים לי השראה',
    photoSource: (name, src) => `מקור התמונה של ${name}: ${src}`,
    linksLabel: (name) => `קישורים של ${name}`,
    photoCredit: (p) => `צילום: ${p}`,
    moreHeading: 'עוד מהסיפורים שלי',
    moreIntro: 'בבלוג אני מתעד עבודה משותפת עם השְׁלוּחִים: מה ביקשתי, מה ניסינו ומה יצא. הנה כמה מהסיפורים:',
    stories: [
      'בנייה עם AI — איך נולד הבלוג הזה',
      'עיצוב ומוצר — מרעיון לתהליך עבודה',
      'עבודה עם צוות עוזרי AI — כתובת מייל אחת לכל הצוות',
    ],
    nav: 'ניווט', back: '→ לכל הסיפורים',
  },
  en: {
    title: 'Humans',
    description: 'People I follow and find inspiring, in AI and beyond. A few words and links so you can get to know them too.',
    seoTitle: 'Humans: people who inspire me',
    seoDescription: `${friends.length} people I follow and find inspiring, in AI and beyond. Short introductions and links to the writing, work and ideas they share.`,
    subtitle: 'People I follow who inspire me',
    intro: 'These are people I follow and learn from, in AI and beyond. A few words about each person and links so you can get to know them too.',
    jumpLabel: 'Jump to a person', onPage: 'On this page', count: `${friends.length} humans`,
    listLabel: 'People who inspire me',
    photoSource: (name, src) => `Photo source for ${name}: ${src}`,
    linksLabel: (name) => `Links for ${name}`,
    photoCredit: () => 'Photo: Dana Barak',
    moreHeading: 'More of my own stories',
    moreIntro: 'On the blog I document working with my shluchim: what I asked for, what we tried and how it turned out. Here are a few of those stories:',
    stories: [
      'Building with AI — how this blog was born',
      'Design and product — from an idea to a workflow',
      'Working with an AI team — one email address for the whole team',
    ],
    nav: 'Navigation', back: '← All stories',
  },
  ar: {
    title: 'بشر',
    description: 'أشخاص أتابعهم وأستلهم من أعمالهم في الذكاء الاصطناعي وخارجه. بضع كلمات وروابط لتتعرف إليهم أيضًا.',
    seoTitle: 'بشر: أشخاص يلهمونني',
    seoDescription: `${friends.length} شخصًا أتابعهم وأستلهم من أعمالهم في الذكاء الاصطناعي وخارجه. نبذة قصيرة عن عمل كل واحد منهم وروابط للمحتوى والأفكار التي يشاركونها.`,
    subtitle: 'أشخاص أتابعهم وأستلهم منهم',
    intro: 'هنا أشخاص أتابعهم وأتعلم من عملهم، في الذكاء الاصطناعي وفي مجالات أخرى. بضع كلمات عن كل شخص وروابط لتتعرف إليهم أيضًا.',
    jumpLabel: 'الانتقال إلى شخص في الصفحة', onPage: 'في هذه الصفحة', count: `${friends.length} شخصًا`,
    listLabel: 'أشخاص يلهمونني',
    photoSource: (name, src) => `مصدر صورة ${name}: ${src}`,
    linksLabel: (name) => `روابط ${name}`,
    photoCredit: () => 'تصوير: دانا باراك',
    moreHeading: 'من حكاياتي في المدونة',
    moreIntro: 'أوثق في المدونة عملي المشترك مع مساعدي الذكاء الاصطناعي: ماذا طلبت، وماذا جربنا، وماذا خرج. إليك بعض الحكايات:',
    stories: [
      'البناء بالذكاء الاصطناعي — كيف وُلدت هذه المدونة',
      'التصميم والمنتج — من فكرة إلى مسار عمل',
      'العمل مع فريق مساعدي الذكاء الاصطناعي — عنوان بريد واحد للفريق كله',
    ],
    nav: 'التنقل', back: '→ كل الحكايات',
  },
};
const copy = COPY[lang];
const title = copy.title;
const description = copy.description;
const seoTitle = withBrand(copy.seoTitle, SITES[lang].title);
const seoDescription = copy.seoDescription;
const STORY_KEYS = [
  { key: '2026-10-10-building-the-shluchim-blog', he: 'posts/2026-10-10-building-the-shluchim-blog/', en: 'posts/2026-10-10-how-the-shluchim-blog-was-born/' },
  { key: '2026-10-08-spec-driven-tickets-redesign', he: 'posts/2026-10-08-spec-driven-tickets-redesign/', en: 'posts/2026-10-08-spec-driven-design-for-the-tickets-page/' },
  { key: '2026-10-11-grokbot-email-inbox', he: 'posts/2026-10-11-grokbot-email-inbox/', en: 'posts/2026-10-11-one-email-address-a-front-door/' },
] as const;
const langPosts = lang === 'ar' ? await getPosts('ar') : [];
const storyLinks = STORY_KEYS.map((s, idx) => {
  if (lang === 'he') return { href: lurl('he', s.he), label: copy.stories[idx], hreflang: undefined };
  if (lang === 'en') return { href: lurl('en', s.en), label: copy.stories[idx], hreflang: undefined };
  const arMatch = langPosts.find((p) => keyOf(p) === s.key);
  return arMatch
    ? { href: postUrl(arMatch), label: copy.stories[idx], hreflang: undefined }
    : { href: lurl('en', s.en), label: copy.stories[idx], hreflang: 'en' as const };
});
const abs = (path: string) => new URL(path, Astro.site).href;
const pageUrl = abs(lurl(lang, 'friends/'));
const ids = nodeIds(abs(lurl('he')), abs(lurl(lang)));
const jsonLd = [
  pageNode({ type: 'CollectionPage', url: pageUrl, name: title, description: seoDescription, lang, websiteId: ids.website,
    list: friends.map((friend) => ({ name: fName(friend), url: friend.links[0].url })) }),
  breadcrumbNode([{ name: SITES[lang].title, url: abs(lurl(lang)) }, { name: title, url: pageUrl }]),
];
---
<Base bodyClass="page-friends" lang={lang} title={title} description={description} seoTitle={seoTitle} seoDescription={seoDescription}
  alternates={{ he: lurl('he', 'friends/'), en: lurl('en', 'friends/'), ar: lurl('ar', 'friends/') }} jsonLd={jsonLd}>
  <header class="page-head human-intro">
    <div class="intro-copy">
    <h1>{title}</h1>
    <p class="page-subtitle">{copy.subtitle}</p>
    <p>{copy.intro}</p>
    </div>
  </header>
  <nav class="people-index" aria-label={copy.jumpLabel}>
    <div class="index-heading"><span>{copy.onPage}</span><span>{copy.count}</span></div>
    <ul>{friends.map((friend) => <li><a href={`#${friend.id}`}>{fName(friend)}</a></li>)}</ul>
  </nav>
  <ul class="friends" aria-label={copy.listLabel}>
    {friends.map((friend, index) => (
      <li class="friend" id={friend.id}>
        <div class="friend-heading">
          <a class="portrait-link" href={friendPortraits[friend.id].source}
            style={`--portrait-color: ${friend.pastel}; --portrait-position: ${friendPortraits[friend.id].position ?? '50% 50%'}`}
            aria-label={copy.photoSource(fName(friend), friendPortraits[friend.id].sourceName)} target="_blank" rel="noopener">
            <img class="person-photo" src={friendPortraits[friend.id].src} alt="" width="80" height="80"
              loading={index < 4 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />
          </a>
          <div class="friend-identity">
            <span class="theme">{fTheme(friend)}</span>
            <h2><a href={friend.links[0].url} target="_blank" rel="noopener">{fName(friend)}</a></h2>
          </div>
        </div>
        <p>{fText(friend)}</p>
        <ul class="friend-links" aria-label={copy.linksLabel(fName(friend))}>
          {friend.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener">{link[lang]}<span aria-hidden="true"> ↗</span></a></li>)}
        </ul>
        {friendPortraits[friend.id].photographer && <p class="photo-credit">{copy.photoCredit(friendPortraits[friend.id].photographer)}</p>}
      </li>
    ))}
  </ul>
  <section class="connections" aria-labelledby="connections-title">
    <h2 id="connections-title">{copy.moreHeading}</h2>
    <p>{copy.moreIntro}</p>
    <ul>
      {storyLinks.map((item) => <li><a href={item.href} hreflang={item.hreflang}>{item.label}</a></li>)}
    </ul>
  </section>
  <nav class="post-foot" aria-label={copy.nav}>
    <a class="back" href={lurl(lang)}>{copy.back}</a>
  </nav>
</Base>
<style>
  :global(.page-friends .wrap) { max-width: 64rem; }
  .human-intro { margin-bottom: 3rem; }
  .eyebrow { color: var(--muted); font-size: var(--step--1); margin: 0 0 1.25rem; }
  .human-intro h1 { font-size: clamp(2.75rem, 6vw, 5rem); line-height: 1.12; letter-spacing: -.025em; margin-bottom: .75rem; }
  .human-intro h1 span { display: block; }
  .human-intro h1 .title-second { font-size: .76em; }
  .human-intro .page-subtitle { font-family: var(--font-display); font-size: var(--step-2); color: var(--fg); margin: 0 0 1.5rem; }
  .intro-copy > p:last-child { max-width: 48ch; margin-bottom: 0; }
  .people-index { padding-block: 1.25rem; border-block: 1px solid var(--rule); margin-bottom: 3rem; }
  .index-heading { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .8125rem; margin-bottom: .75rem; }
  .people-index ul { display: flex; flex-wrap: wrap; gap: .1rem .3rem; margin: 0; padding: 0; list-style: none; }
  .people-index li { display: flex; align-items: center; }
  .people-index li:not(:last-child)::after { content: '·'; color: var(--muted); margin-inline: .5rem; }
  .people-index a { font-size: var(--step--1); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .people-index a:hover { text-decoration: underline; }
  .friends { list-style: none; padding: 0; margin: 0 0 3rem; display: grid; gap: 0 3rem; }
  .friend { border-top: 1px solid var(--line); padding-block: 1.75rem 2rem; display: flex; flex-direction: column; min-width: 0; scroll-margin-top: 1.5rem; }
  .friend-heading { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
  .portrait-link { display: block; width: 5rem; height: 5rem; flex: 0 0 5rem; border: 3px solid var(--portrait-color); border-radius: 50%; background: var(--portrait-color); overflow: hidden; }
  .person-photo { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: var(--portrait-position); }
  .friend-identity { min-width: 0; }
  .friend-identity h2 { margin: .25rem 0 0; }
  .theme { color: var(--muted); font-size: .8125rem; }
  .friend h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.875rem, 3vw, 2.5rem); margin: 0 0 .75rem; }
  .friend h2 a { color: var(--fg); text-decoration: none; }
  .friend h2 a:hover { text-decoration: underline; }
  .friend p { margin: 0 0 1rem; max-width: 42ch; }
  .friend-links { display: flex; flex-wrap: wrap; gap: .3rem 1rem; list-style: none; padding: 0; margin: auto 0 0; font-size: var(--step--1); }
  .friend-links a { display: inline-flex; gap: .2rem; align-items: center; min-height: 2.75rem; }
  .friend .photo-credit { color: var(--muted); font-size: .8125rem; margin: .25rem 0 0; }
  .connections { background: var(--surface); padding: clamp(1.25rem, 3vw, 2.5rem); border-inline-start: 3px solid var(--fg); }
  .connections h2 { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); }
  .connections p { max-width: 58ch; }
  .connections ul { padding-inline-start: 1.25rem; margin-bottom: 0; }
  .connections li { margin-block: .75rem; }
  :global(:root:lang(en)) .friend h2 { font-family: var(--font-display-en, var(--font-system)); }
  @media (min-width: 48rem) {
    .friends { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 25rem) { .human-intro h1 { font-size: 2.65rem; } }
</style>
