---
import { PRESENCE_URL, PRESENCE_PUBLISHABLE_KEY } from '../config';
import spriteUrl from '../assets/bloub-readers.svg?url';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<section class="online-readers wrap" data-online-readers data-url={PRESENCE_URL} data-key={PRESENCE_PUBLISHABLE_KEY} data-lang={lang} data-sprite={spriteUrl} aria-label={lang === 'he' ? 'קוראים כאן יחד' : 'Reading together'}>
  <div class="readers-panel">
    <p class="readers-caption"><span class="online-dot" aria-hidden="true"></span><span data-readers-label></span></p>
    <div class="readers-crowd" data-readers-crowd dir="rtl" tabindex="0" role="group" aria-label={lang === 'he' ? 'דמויות הקוראים, אפשר לגלול שמאלה' : 'Reader characters; scroll left to see more'}><span data-readers-overflow hidden></span></div>
  </div>
</section>
<noscript><style is:inline>.online-readers{display:none}</style></noscript>

<script>
  import { mountOnlineReaders } from '../lib/presence';
  const counter = document.querySelector<HTMLElement>('[data-online-readers]');
  if (counter) mountOnlineReaders(counter);
</script>

<style>
  /* A stable band below the header: revealing even a large crowd never moves the story. */
  .online-readers { block-size: 4rem; padding-block-start: .5rem; visibility: hidden; }
  .online-readers[data-ready] { visibility: visible; }
  .readers-panel { display: flex; align-items: center; gap: .75rem; border-block: 1px solid var(--line); block-size: 100%; }
  /* Short counts keep the stable 8.5rem column; the longer one-reader sentence may widen it or wrap to two lines, always leaving room for the reader's avatar. */
  .readers-caption { display: flex; align-items: center; flex: 0 1 auto; min-inline-size: 8.5rem; max-inline-size: calc(100% - 3.25rem); gap: .4em; margin: 0; color: var(--muted); font-size: .8125rem; line-height: 1.5; font-variant-numeric: tabular-nums; }
  [data-lang="en"] .readers-caption { min-inline-size: 10rem; }
  [data-readers-label] { min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; }
  .online-dot { inline-size: .4em; block-size: .4em; border-radius: 50%; background: currentColor; flex: none; }
  .readers-crowd { display: flex; align-items: center; gap: .375rem; flex: 1; min-inline-size: 0; block-size: 3rem; overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; }
  .readers-crowd:focus-visible { outline: 2px solid var(--fg); outline-offset: -2px; }
  [data-readers-overflow] { order: 1; flex: none; direction: ltr; color: var(--muted); font-size: .8125rem; }
  .readers-crowd :global(svg) { inline-size: 2.5rem; block-size: 2.5rem; flex: none; contain: strict; color: light-dark(oklch(58% .18 var(--reader-hue)), oklch(76% .15 var(--reader-hue))); }
  .readers-crowd :global(.reader-blink) { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .online-readers[data-ready] .readers-crowd :global([data-moving][data-blinking] .reader-blink) { animation: reader-blink .18s linear; }
    .online-readers[data-ready] .readers-crowd :global([data-moving][data-looking] .reader-gaze) { animation: reader-gaze 1.2s steps(3, end); }
  }
  /* Bloub's idle life is gaze drift and a quick vertical blink, not floating bodies. */
  @keyframes reader-blink { 0%,100% { transform: scaleY(1); } 45% { transform: scaleY(.06); } }
  @keyframes reader-gaze { 0%,100% { transform: translate(0, 0); } 25% { transform: translate(4px, -3px); } 50% { transform: translate(-4px, 2px); } 75% { transform: translate(2px, 3px); } }
</style>
