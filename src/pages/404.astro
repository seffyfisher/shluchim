---
import Base from '../layouts/Base.astro';
import '../styles/not-found.css';
import shluchim from '../data/shluchim.json';
import { TOPICS, TOPIC_SLUGS } from '../data/topics.mjs';
import { lurl } from '../i18n/ui';
import { getPosts, postUrl } from '../lib/posts';

// A small, still group keeps the recital as the only moving focal point.
const portraits = import.meta.glob<string>('../assets/shluchim/*-still.webp', { eager: true, query: '?url', import: 'default' });
const selectedHeads = ['basher', 'nitza', 'kochava', 'chef'];
const people = shluchim.filter((person) => selectedHeads.includes(person.id)).map((person) => {
  const image = portraits[`../assets/${person.still}`];
  if (!image) throw new Error(`Missing 404 portrait: ${person.still}`);
  return { ...person, image };
});
const sceneDescription = `ארבעה ראשים של השְׁלוּחִים — ${people.map((person) => person.name).join(', ')} — סביב מצבת דפדפן עם 404. נוסח הקדיש מופיע לפי סדר הקריאה ונע מטה.`;
const [hePosts, enPosts] = await Promise.all([getPosts('he'), getPosts('en')]);
const siteLinks = [
  { name: 'דף הבית', path: '' }, { name: 'השְׁלוּחִים', path: 'team/' },
  { name: 'בני אנוש', path: 'friends/' }, { name: 'אודות', path: 'about/' },
];
const englishLinks = [
  { name: 'Home & stories', path: '' }, { name: 'The Shluchim', path: 'team/' },
  { name: 'Humans', path: 'friends/' }, { name: 'About', path: 'about/' },
];
---
<Base lang="he" bodyClass="page-404" title="קדש" seoTitle="קדש: העמוד לא נמצא (404) · שְׁלוּחִים"
  description="העמוד שחיפשת כבר לא איתנו. השְׁלוּחִים התכנסו לקד(י)ש קטן, ומכאן אפשר לחזור לדף הבית, לצוות ולכל המעשיות בעברית ובאנגלית.">
  <div class="not-found">
    <header class="hero">
      <h1>קדש</h1>
      <p class="gematria"><strong><bdi>404</bdi> בגמטריא = קד(י)ש</strong></p>
    </header>
    <figure class="ceremony" aria-label={sceneDescription}>
      <div class="stage" role="group" aria-label={sceneDescription}>
        <section class="teleprompter" aria-label="קדיש לעמוד האבוד">
          <div class="prompt-window">
            <div class="prompt-block prompt-block-intro">
              <p class="prompt-line prompt-intro">העמוד שחיפשת כבר לא איתנו.</p>
              <p class="prompt-line prompt-intro">אולי הוא הוסר,</p>
              <p class="prompt-line prompt-intro">אולי הועבר,</p>
              <p class="prompt-line prompt-intro">ואולי פשוט הלך לעולם שכולו טוב.</p>
            </div>
            <div class="prompt-block prompt-block-gathering">
              <p class="prompt-line prompt-intro">לזכרו, כינסנו את כל השלוחים</p>
              <p class="prompt-line prompt-intro">ואמרנו עליו קד(י)ש קטן:</p>
            </div>
            <div class="prompt-block prompt-block-prayer">
              <p class="prompt-line"><strong>יתגדל ויתקדש שמיה דהאתר,</strong></p>
              <p class="prompt-line">ויהא זכרו של העמוד האבוד שמור עמנו,</p>
              <p class="prompt-line">אף כי לא נטען,</p>
              <p class="prompt-line">אף כי לא נמצא,</p>
              <p class="prompt-line">אף כי החזיר ארבע-מאות-וארבע.</p>
            </div>
            <div class="prompt-block prompt-block-comfort">
              <p class="prompt-line">המקום ינחם את מחפשי הדפים,</p>
              <p class="prompt-line">וישיב את כולנו בשלום</p>
              <p class="prompt-line">אל דף הבית,</p>
              <p class="prompt-line">אל החיפוש,</p>
              <p class="prompt-line">או לפחות אל מקום שכן עובד.</p>
            </div>
            <div class="prompt-block prompt-block-amen">
              <p class="prompt-line prompt-amen"><strong>אמן.</strong></p>
            </div>
          </div>
          <div class="memorial" aria-hidden="true">
            <div class="participants">
              {people.slice(0, 2).map((person) => <img class="head" data-character={person.id} src={person.image} width="128" height="128" alt="" decoding="async" />)}
            </div>
            <div class="tombstone sprite" style="--col:1;--row:3"></div>
            <div class="participants">
              {people.slice(2).map((person) => <img class="head" data-character={person.id} src={person.image} width="128" height="128" alt="" decoding="async" />)}
            </div>
          </div>
        </section>
      </div>
    </figure>
    <section class="page-footer" aria-labelledby="other-pages-heading">
      <h2 id="other-pages-heading">לכל שאר הדפים החיים</h2>
      <div class="sitemap-columns">
        <nav aria-label="האתר"><h3>האתר</h3>{siteLinks.map((link) => <a href={lurl('he', link.path)}>{link.name}</a>)}<a href={`${lurl('he')}#stories`}>רשימת המעשיות</a><a href="https://he.wikipedia.org/wiki/%D7%97%D7%91%D7%A8%D7%94_%D7%A7%D7%93%D7%99%D7%A9%D7%90" target="_blank" rel="noopener noreferrer">עוד על חברה קדישא</a></nav>
        <nav aria-label="הנושאים"><h3>הנושאים</h3>{TOPIC_SLUGS.map((slug) => <a href={lurl('he', `topics/${slug}/`)}>{TOPICS[slug as keyof typeof TOPICS].he.label}</a>)}</nav>
        <nav lang="en" dir="ltr" aria-label="In English"><h3>In English</h3>{englishLinks.map((link) => <a href={lurl('en', link.path)}>{link.name}</a>)}{TOPIC_SLUGS.map((slug) => <a href={lurl('en', `topics/${slug}/`)}>{TOPICS[slug as keyof typeof TOPICS].en.label}</a>)}</nav>
      </div>
      <div class="story-index">
        <section class="story-list"><h3>כל המעשיות בעברית ({hePosts.length})</h3><ul>{hePosts.map((post) => <li><a href={postUrl(post)}>{post.data.title}</a></li>)}</ul></section>
        <section class="story-list" lang="en" dir="ltr"><h3>All stories in English ({enPosts.length})</h3><ul>{enPosts.map((post) => <li><a href={postUrl(post)}>{post.data.title}</a></li>)}</ul></section>
      </div>
    </section>
  </div>
</Base>
