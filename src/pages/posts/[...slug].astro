---
import FeedbackBlock from '../../components/FeedbackBlock.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getPosts, url, formatDate, readingMinutes, readingLabel } from '../../lib/posts';
import { REPO } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const editUrl = `https://github.com/${REPO}/edit/main/${post.filePath ?? `src/content/posts/${post.id}.md`}`;
---
<Base title={d.title} description={d.description} noindex={d.draft}>
  <article>
    <header class="post-head">
      <p class="meta">
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
        <span>{readingLabel(readingMinutes(post.body))}</span>
        {d.tags?.length ? <span>{d.tags.join(', ')}</span> : null}
        {d.draft && <span class="badge">טיוטה</span>}
      </p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
    </header>
    {d.cover && <Image class="cover" src={d.cover} alt={d.coverAlt ?? ''} widths={[400, 800, 1200]} sizes="(max-width: 46rem) 100vw, 46rem" />}
    <div class="prose">
      <Content />
    </div>
  </article>
  <FeedbackBlock placement="post" />
  <nav class="post-foot" aria-label="ניווט בסוף הסיפור">
    <a class="back" href={url()}>→ לכל הסיפורים</a>
    <a class="edit" href={editUrl} rel="nofollow">עריכה ב־GitHub</a>
  </nav>
</Base>
