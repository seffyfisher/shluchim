---
import Base from '../layouts/Base.astro';
import { getPosts, url, formatDate } from '../lib/posts';
const posts = await getPosts();
---
<Base>
  <h1 class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">כל הסיפורים</h1>
  {posts.length === 0 ? (
    <p class="empty">עוד אין סיפורים. בקרוב.</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <h2>
            <a href={url(`posts/${p.id}/`)}>{p.data.title}</a>
            {p.data.draft && <span class="badge">טיוטה</span>}
          </h2>
          <time class="meta" datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
