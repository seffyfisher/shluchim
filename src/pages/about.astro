---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { url } from '../lib/posts';
const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description} bodyClass="page-about">
  <style slot="head" set:html={`.page-about{--sheet:url(${url('about/yawn-lg.webp')})}@media (max-width:63.99rem){.page-about{--sheet:url(${url('about/yawn-sm.webp')})}}`}></style>
  <div class="about">
    <article class="prose">
      <Content />
    </article>
    <aside class="avatar-col" aria-hidden="true">
      <figure class="about-av">
        <div class="avatar-sprite" id="av"></div>
        <picture class="avatar-still">
          <source media="(max-width: 63.99rem)" srcset={url('about/still-sm.webp')} />
          <img src={url('about/still-lg.webp')} alt="" width="480" height="480" />
        </picture>
      </figure>
    </aside>
  </div>
  <script is:inline>(()=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;const e=document.getElementById('av');let r=0,l=-1;const d=()=>{r=0;const f=Math.floor(scrollY/innerHeight*30)%60;if(f!==l){l=f;e.style.backgroundPosition=f%10*100/9+'% '+(f/10|0)*20+'%';e.dataset.f=f}};addEventListener('scroll',()=>{r||(r=requestAnimationFrame(d))},{passive:true});d()})()</script>
</Base>
