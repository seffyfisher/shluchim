---
import '../styles/global.css';
import fontUrl from '../fonts/miriam-libre-var.woff2?url';
import { SITE, SHOW_DRAFTS } from '../config';
import { url } from '../lib/posts';
interface Props { title?: string; description?: string; noindex?: boolean; masthead?: boolean; bodyClass?: string }
const { title, description = SITE.tagline, noindex = false, masthead = false, bodyClass } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141414" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="he_IL" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="icon" type="image/gif" href={url('favicon-animated-64-roundsq.gif')} />
    <link rel="icon" href={url('favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <slot name="head" />
    {(noindex || SHOW_DRAFTS) && <meta name="robots" content="noindex" />}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">דלג לתוכן</a>
    {SHOW_DRAFTS && <div class="preview-banner" role="note">מצב תצוגה מקדימה: כולל טיוטות שלא אושרו לפרסום</div>}
    {masthead ? (
      <header class="site masthead">
        <div class="wrap">
          {SITE.kicker && <p class="kicker">{SITE.kicker}</p>}
          <h1><a href={url()} aria-current="page" aria-label={SITE.title} title={SITE.title}>{(() => { const t = SITE.displayTitle ?? SITE.title; const cut = [...t].findIndex((c, i, a) => i > 0 && a.slice(0, i).join('').normalize('NFD').replace(/[\u0591-\u05C7]/g, '') === 'של' && !/[\u0591-\u05C7]/.test(c)); return cut > 0 ? <><span class="t-a" aria-hidden="true">{[...t].slice(0, cut).join('')}</span><span class="t-b" aria-hidden="true">{[...t].slice(cut).join('')}</span></> : t; })()}</a></h1>
          <p class="tagline">{SITE.tagline}</p>
          <nav class="site-nav" aria-label="ראשי"><a href={url()} aria-current={Astro.url.pathname === url() ? 'page' : undefined}>סיפורים</a><a href={url('team/')} aria-current={Astro.url.pathname.startsWith(url('team/')) ? 'page' : undefined}>השְׁלוּחִים</a><a href={url('about/')} aria-current={Astro.url.pathname.startsWith(url('about/')) ? 'page' : undefined}>אודות</a></nav>
        </div>
      </header>
    ) : (
      <header class="site bar">
        <div class="wrap">
          <a class="name" href={url()}>{SITE.title}</a>
          {SITE.kicker && <span class="kicker" lang="en" dir="ltr">{SITE.kicker}</span>}
          <nav class="site-nav" aria-label="ראשי"><a href={url()} aria-current={Astro.url.pathname === url() ? 'page' : undefined}>סיפורים</a><a href={url('team/')} aria-current={Astro.url.pathname.startsWith(url('team/')) ? 'page' : undefined}>השְׁלוּחִים</a><a href={url('about/')} aria-current={Astro.url.pathname.startsWith(url('about/')) ? 'page' : undefined}>אודות</a></nav>
        </div>
      </header>
    )}
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>{SITE.footerNote}</p>
        <p class="links"><a href={url()}>כל הסיפורים</a><a href={url('team/')}>השְׁלוּחִים</a><a href={url('about/')}>אודות</a><a href={url('rss.xml')}>RSS</a></p>
      </div>
    </footer>
  </body>
</html>
