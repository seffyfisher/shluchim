---
import '../styles/global.css';
import fontUrl from '../fonts/miriam-libre-var.woff2?url';
import { SITES, SHOW_DRAFTS, SHOW_SWITCHER_ON_HE } from '../config';
import { LANG_META, lurl, other, t, isLang, type Lang } from '../i18n/ui';
interface Props {
  title?: string; description?: string; noindex?: boolean; masthead?: boolean; bodyClass?: string;
  lang?: Lang;
  /** Counterpart pages (full paths incl. base). Only pass a language when that page really exists. */
  alternates?: Partial<Record<Lang, string>>;
}
const lang: Lang = Astro.props.lang ?? (isLang(Astro.currentLocale) ? Astro.currentLocale : 'he');
const SITE = SITES[lang];
const ui = t(lang);
const meta = LANG_META[lang];
const { title, description = SITE.tagline, noindex = false, masthead = false, bodyClass } = Astro.props;
const alternates: Partial<Record<Lang, string>> = { ...(Astro.props.alternates ?? {}), [lang]: Astro.url.pathname };
const hasAlt = Object.keys(alternates).length > 1;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const url = (p = '') => lurl(lang, p);
const o = other(lang);
const showSwitch = lang !== 'he' || SHOW_SWITCHER_ON_HE;
const switchHref = alternates[o] ?? lurl(o);
---
<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141414" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={meta.og} />
    {hasAlt && <meta property="og:locale:alternate" content={LANG_META[o].og} />}
    {hasAlt && (['he', 'en'] as Lang[]).map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l]!, Astro.site)} />)}
    {hasAlt && <link rel="alternate" hreflang="x-default" href={new URL(alternates.he!, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={lurl('he', 'sitemap-index.xml')} />
    <link rel="icon" type="image/gif" href={lurl('he', 'favicon-animated.gif')} />
    <link rel="icon" href={lurl('he', 'favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={lurl('he', 'favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={lurl('he', 'apple-touch-icon.png')} />
    <link rel="manifest" href={lurl('he', 'site.webmanifest')} />
    <slot name="head" />
    {(noindex || SHOW_DRAFTS) && <meta name="robots" content="noindex" />}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{ui.skip}</a>
    {SHOW_DRAFTS && <div class="preview-banner" role="note">{ui.preview}</div>}
    {masthead ? (
      <header class="site masthead">
        <div class="wrap">
          {SITE.kicker && <p class="kicker">{SITE.kicker}</p>}
          <h1><a href={url()} aria-current="page" aria-label={SITE.title} title={SITE.title}>{lang !== 'he' ? SITE.displayTitle : (() => { const t = SITE.displayTitle ?? SITE.title; const cut = [...t].findIndex((c, i, a) => i > 0 && a.slice(0, i).join('').normalize('NFD').replace(/[\u0591-\u05C7]/g, '') === 'של' && !/[\u0591-\u05C7]/.test(c)); return cut > 0 ? <><span class="t-a" aria-hidden="true">{[...t].slice(0, cut).join('')}</span><span class="t-b" aria-hidden="true">{[...t].slice(cut).join('')}</span></> : t; })()}</a></h1>
          <p class="tagline">{SITE.tagline}</p>
          {SITE.explainer && <p class="explainer">{SITE.explainer}</p>}
          <nav class="site-nav" aria-label={ui.navMain}><a href={url()} aria-current={Astro.url.pathname === url() ? 'page' : undefined}>{ui.stories}</a><a href={url('team/')} aria-current={Astro.url.pathname.startsWith(url('team/')) ? 'page' : undefined}>{ui.team}</a><a href={url('about/')} aria-current={Astro.url.pathname.startsWith(url('about/')) ? 'page' : undefined}>{ui.about}</a>{showSwitch && <a class="lang" href={switchHref} hreflang={o} lang={o} title={ui.switchHint}>{ui.switchTo}</a>}</nav>
        </div>
      </header>
    ) : (
      <header class="site bar">
        <div class="wrap">
          <a class="name" href={url()}>{SITE.title}</a>
          {SITE.kicker && <span class="kicker" lang="en" dir="ltr">{SITE.kicker}</span>}
          <nav class="site-nav" aria-label={ui.navMain}><a href={url()} aria-current={Astro.url.pathname === url() ? 'page' : undefined}>{ui.stories}</a><a href={url('team/')} aria-current={Astro.url.pathname.startsWith(url('team/')) ? 'page' : undefined}>{ui.team}</a><a href={url('about/')} aria-current={Astro.url.pathname.startsWith(url('about/')) ? 'page' : undefined}>{ui.about}</a>{showSwitch && <a class="lang" href={switchHref} hreflang={o} lang={o} title={ui.switchHint}>{ui.switchTo}</a>}</nav>
        </div>
      </header>
    )}
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>{SITE.footerNote}</p>
        <p class="links"><a href={url()}>{ui.allStories}</a><a href={url('team/')}>{ui.team}</a><a href={url('about/')}>{ui.about}</a><a href={url('rss.xml')}>RSS</a></p>
      </div>
    </footer>
  </body>
</html>
